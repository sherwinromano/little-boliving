<section class="why-trust-us" data-section-id="{{ section.id }}">
  <div class="why-trust-us__container">
    <div class="why-trust-us__richtext">
      {%- if section.settings.heading != blank -%}
        <h2 class="why-trust-us__heading poppins-bold">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <h4 class="why-trust-us__subheading">{{ section.settings.subheading }}</h4>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="why-trust-us__grid">
        {%- for block in section.blocks -%}
          <div class="why-trust-us__card" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              <div class="why-trust-us__icon">
                <img
                  src="{{ block.settings.icon | image_url }}"
                  alt="{{ block.settings.title }}"
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="why-trust-us__title">{{ block.settings.title }}</h3>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="why-trust-us__grid">
        <div class="why-trust-us__card">
          <div class="why-trust-us__icon">
            <img
              src="{{ 'layers-logo.svg' | asset_url }}"
              alt="Layers logo"
              width="56"
              height="56"
              loading="lazy"
            >
          </div>
          <h3 class="why-trust-us__title inter-bold">Non toxic materials</h3>
        </div>
        <div class="why-trust-us__card">
          <div class="why-trust-us__icon">
            <img
              src="{{ 'elements.svg' | asset_url }}"
              alt="Elements logo"
              width="46"
              height="51"
              loading="lazy"
            >
          </div>
          <h3 class="why-trust-us__title inter-bold">Safety certificates</h3>
        </div>
        <div class="why-trust-us__card">
          <div class="why-trust-us__icon">
            <img
              src="{{ 'elements-shield.svg' | asset_url }}"
              alt="Elements shield logo"
              width="46"
              height="51"
              loading="lazy"
            >
          </div>
          <h3 class="why-trust-us__title inter-bold">Child-safe edges</h3>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .why-trust-us {
    padding: 60px 0 0 0;
  }

  .why-trust-us__container {
    max-width: 1376px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Heading */
  .why-trust-us__heading {
    font-size: 32px;
    color: #343434;
    text-align: center;
    margin: 0 0 16px 0;
    line-height: 100%;
  }

  .why-trust-us__subheading {
    text-align: center;
    font-size: 16px;
    color: #000;
  }

  /* Grid */
  .why-trust-us__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    padding-block: 16px;
  }

  /* Card */
  .why-trust-us__card {
    border: 1px solid #dfdfdf;
    border-radius: 20px;
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    height: fit-content;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .why-trust-us__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
  }

  /* Icon */
  .why-trust-us__icon {
    height: 56px;
    width: 56px;
    display: flex;
    margin-bottom: 8px;
  }

  .why-trust-us__icon img {
    width: 100%;
    height: 100%;
  }

  /* Title */
  .why-trust-us__title {
    font-size: 20px;
    color: #535353;
    text-align: center;
  }

  /* ========================================
     TABLET STYLES (min-width: 768px)
     ======================================== */

  @media (min-width: 768px) {
    .why-trust-us {
      padding: 80px 0 0 0;
    }

    .why-trust-us__container {
      padding: 0 32px;
    }

    .why-trust-us__heading {
      font-size: 48px;
    }

    .why-trust-us__subheading {
      font-size: 18px;
    }

    .why-trust-us__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .why-trust-us__card {
      padding: 64 32px;
      height: fit-content;
    }

    .why-trust-us__title {
      font-size: 20px;
    }
  }

  /* ========================================
     DESKTOP STYLES (min-width: 1024px)
     ======================================== */

  @media (min-width: 1024px) {
    .why-trust-us {
      padding: 100px 0 0 0;
    }

    .why-trust-us__container {
      padding: 0 40px;
    }

    .why-trust-us__heading {
      font-size: 52px;
    }

    .why-trust-us__grid {
      gap: 24px;
    }

    .why-trust-us__card {
      min-height: 216px;
    }

    .why-trust-us__title {
      font-size: 22px;
    }
  }
</style>

{% schema %}
{
  "name": "Why Parents Trust Us",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Parents Trust Us"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "We focus on quality, safety, and comfort to give parents confidence in every purchase."
    }
  ],
  "blocks": [
    {
      "type": "trust_card",
      "name": "Trust Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon",
          "info": "Recommended size: 80x80px"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Non-toxic materials"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Parents Trust Us",
      "category": "Little BoLiving",
      "blocks": [
        {
          "type": "trust_card",
          "settings": {
            "title": "Non-toxic materials"
          }
        },
        {
          "type": "trust_card",
          "settings": {
            "title": "Safety certificates"
          }
        },
        {
          "type": "trust_card",
          "settings": {
            "title": "Child-safe edges"
          }
        }
      ]
    }
  ]
}
{% endschema %}
