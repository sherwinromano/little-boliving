{{ 'header.css' | asset_url | stylesheet_tag }}

<header class="custom-header" data-section-id="{{ section.id }}">
  <div class="custom-header__container">
    {%- if section.settings.logo != blank -%}
      <a href="{{ routes.root_url }}" class="custom-header__logo">
        <img
          src="{{ section.settings.logo | image_url: width: section.settings.logo_width }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_height }}"
          loading="eager"
          style="width: {{ section.settings.logo_width }}px; height: auto;"
        >
      </a>
    {%- else -%}
      <a href="{{ routes.root_url }}" class="custom-header__logo">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="Little BoLiving icon"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_height }}"
          loading="eager"
          style="width: {{ section.settings.logo_width }}px; height: auto;"
        >
      </a>
    {%- endif -%}

    <nav class="custom-header__nav" aria-label="Main navigation">
      <ul class="custom-header__nav-list">
        {%- for link in section.settings.menu.links -%}
          <li class="custom-header__nav-item">
            <a
              href="{{ link.url }}"
              class="custom-header__nav-link {% if link.active %} inter-bold{% endif %}"
            >
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    {%- comment -%} Right Side Actions {%- endcomment -%}
    <div class="custom-header__actions">
      <a href="{{ routes.cart_url }}" class="custom-header__cart-btn" aria-label="Shopping cart">
        <span class="custom-header__cart-text inter-bold">Basket</span>
        <img src="{{ 'shopping-cart.svg' | asset_url }}" alt="Shopping cart icon" width="24" height="24">
        <span
          class="custom-header__cart-count"
          {% if cart.item_count == 0 %}
            style="display: none;"
          {% endif %}
        >
          {{ cart.item_count }}
        </span>
      </a>

      <button class="custom-header__menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="custom-header__menu-icon">
          <img src="{{ 'menu-icon.svg' | asset_url }}" alt="Menu icon" width="24" height="24">
        </span>
        <span class="custom-header__close-icon">
          <img src="{{ 'close-icon.svg' | asset_url }}" alt="Close icon" width="24" height="24">
        </span>
      </button>
    </div>
  </div>

  {%- comment -%} Mobile Menu Overlay {%- endcomment -%}
  <aside class="custom-header__mobile-menu">
    <nav class="custom-header__mobile-nav" aria-label="Mobile navigation">
      <ul class="custom-header__mobile-nav-list">
        {%- for link in section.settings.menu.links -%}
          <li class="custom-header__mobile-nav-item">
            <a
              href="{{ link.url }}"
              class="custom-header__mobile-nav-link{% if link.active %} inter-bold{% endif %}"
            >
              {{ link.title }}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  </aside>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const header = document.querySelector('.custom-header');
    const menuToggle = document.querySelector('.custom-header__menu-toggle');
    const mobileMenu = document.querySelector('.custom-header__mobile-menu');
    const mobileLinks = document.querySelectorAll('.custom-header__mobile-nav-link');

    if (menuToggle) {
      menuToggle.addEventListener('click', function () {
        const isOpen = header.classList.toggle('menu-open');
        menuToggle.setAttribute('aria-expanded', isOpen);

        if (isOpen) {
          document.body.style.overflow = 'hidden';
        } else {
          document.body.style.overflow = '';
        }
      });
    }

    mobileLinks.forEach((link) => {
      link.addEventListener('click', function () {
        header.classList.remove('menu-open');
        menuToggle.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      });
    });

    if (mobileMenu) {
      mobileMenu.addEventListener('click', function (e) {
        if (e.target === mobileMenu) {
          header.classList.remove('menu-open');
          menuToggle.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
        }
      });
    }
  });
</script>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "header",
      "content": "Logo Settings"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 40,
      "max": 300,
      "step": 5,
      "default": 85,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height (px)",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 55,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Navigation Settings"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Custom Header",
      "category": "Little BoLiving"
    }
  ]
}
{% endschema %}
