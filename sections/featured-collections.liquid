<section class="featured-collections" data-section-id="{{ section.id }}">
  <div class="featured-collections__container">
    <div class="featured-collections__richtext">
      {%- if section.settings.heading != blank -%}
        <h2 class="featured-collections__heading poppins-bold">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <h4 class="featured-collections__subheading">{{ section.settings.subheading }}</h4>
      {%- endif -%}
    </div>

    {%- comment -%} Tab Navigation {%- endcomment -%}
    {%- if section.blocks.size > 0 -%}
      <div class="featured-collections__wrapper">
        <div class="featured-collections__tabs">
          <div class="featured-collections__tabs-wrapper">
            {%- for block in section.blocks -%}
              <div
                class="featured-collections__tab inter-bold {% if forloop.first %}active{% endif %}"
                data-tab-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {{ block.settings.tab_label }}
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>

      {%- comment -%} Product Grid Panels {%- endcomment -%}
      <div class="featured-collections__content">
        {%- for block in section.blocks -%}
          <div
            class="featured-collections__panel {% if forloop.first %}active{% endif %}"
            data-panel-index="{{ forloop.index0 }}"
          >
            <div class="featured-collections__grid">
              {%- if block.settings.product_1 != blank -%}
                <div class="featured-collections__product-card featured-collections__product-card--1">
                  {%- if block.settings.product_1_url != blank -%}
                    <a href="{{ block.settings.product_1_url }}" class="featured-collections__product-link">
                  {%- endif -%}
                  {%- if block.settings.product_1_image != blank -%}
                    <div class="featured-collections__product-image">
                      <img
                        src="{{ block.settings.product_1_image | image_url }}"
                        alt="{{ block.settings.product_1_alt | default: 'Product image' }}"
                        width="{{ block.settings.product_1_image.width }}"
                        height="{{ block.settings.product_1_image.height }}"
                        loading="lazy"
                      >
                    </div>
                  {%- else -%}
                    <div class="featured-collections__product-image">
                      <img
                        src="{{ 'featured-img-1.png' | asset_url }}"
                        alt="Featured product image"
                        width="1024"
                        height="1536"
                        loading="lazy"
                      >
                    </div>
                  {%- endif -%}
                  {%- if block.settings.product_1_url != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.product_2 != blank -%}
                <div class="featured-collections__product-card featured-collections__product-card--2">
                  {%- if block.settings.product_2_url != blank -%}
                    <a href="{{ block.settings.product_2_url }}" class="featured-collections__product-link">
                  {%- endif -%}
                  {%- if block.settings.product_2_image != blank -%}
                    <div class="featured-collections__product-image">
                      <img
                        src="{{ block.settings.product_2_image | image_url }}"
                        alt="{{ block.settings.product_2_alt | default: 'Product image' }}"
                        width="{{ block.settings.product_2_image.width }}"
                        height="{{ block.settings.product_2_image.height }}"
                        loading="lazy"
                      >
                    </div>
                  {%- else -%}
                    <div class="featured-collections__product-image">
                      <img
                        src="{{ 'featured-img-2.png' | asset_url }}"
                        alt="Featured product image"
                        width="1024"
                        height="1536"
                        loading="lazy"
                      >
                    </div>
                  {%- endif -%}
                  {%- if block.settings.product_2_url != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if block.settings.product_3 != blank -%}
                <div class="featured-collections__product-card featured-collections__product-card--3">
                  {%- if block.settings.product_3_url != blank -%}
                    <a href="{{ block.settings.product_3_url }}" class="featured-collections__product-link">
                  {%- endif -%}
                  {%- if block.settings.product_3_image != blank -%}
                    <div class="featured-collections__product-image">
                      <img
                        src="{{ block.settings.product_3_image | image_url }}"
                        alt="{{ block.settings.product_3_alt | default: 'Product image' }}"
                        width="{{ block.settings.product_3_image.width }}"
                        height="{{ block.settings.product_3_image.height }}"
                        loading="lazy"
                      >
                    </div>
                  {%- else -%}
                    <div class="featured-collections__product-image">
                      <img
                        src="{{ 'featured-img-3.png' | asset_url }}"
                        alt="Featured product image"
                        width="1024"
                        height="1536"
                        loading="lazy"
                      >
                    </div>
                  {%- endif -%}
                  {%- if block.settings.product_3_url != blank -%}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- comment -%} Explore Collection Button {%- endcomment -%}
      {%- if section.settings.button_text != blank and section.settings.button_url != blank -%}
        <div class="featured-collections__button-wrapper">
          <a href="{{ section.settings.button_url }}" class="featured-collections__button inter-bold">
            {{ section.settings.button_text }}
          </a>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

<style>
  .featured-collections {
    padding: 60px 0 0 0;
  }

  .featured-collections__container {
    max-width: 1376px;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* Heading */
  .featured-collections__richtext {
    margin-bottom: 32px;
  }

  .featured-collections__heading {
    font-size: 32px;
    color: #343434;
    text-align: center;
    margin: 0 0 16px 0;
  }

  .featured-collections__subheading {
    font-size: 1rem;
    color: #000;
    text-align: center;
    margin: 0;
    font-weight: 400;
    line-height: 150%;
  }

  /* Tab Navigation */
  .featured-collections__wrapper {
    display: flex;
    overflow: auto;
    margin-bottom: 32px;
    justify-content: start;
    user-select: none;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .featured-collections__wrapper::-webkit-scrollbar {
    display: none;
  }

  .featured-collections__tabs {
    display: flex;
    justify-content: center;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .featured-collections__tabs::-webkit-scrollbar {
    display: none;
  }

  .featured-collections__tabs-wrapper {
    display: inline-flex;
    gap: 0;
    background-color: #f3e8df;
    border-radius: 1000px;
    padding: 2px;
    min-width: max-content;
  }

  .featured-collections__tabs-wrapper.active-drag {
    cursor: grabbing;
  }

  .featured-collections__tab {
    padding: 16px 24px;
    background-color: transparent;
    border: none;
    border-radius: 1000px;
    color: #000;
    font-size: 1rem;
    transition: all 0.3s ease;
    white-space: nowrap;
    cursor: pointer;
  }

  .featured-collections__tab.active {
    background-color: #d4a991;
    color: #fff;
  }

  .featured-collections__tab:hover:not(.active) {
    background-color: rgba(212, 169, 145, 0.3);
  }

  /* Content Panels */
  .featured-collections__content {
    position: relative;
  }

  .featured-collections__panel {
    display: none;
  }

  .featured-collections__panel.active {
    display: block;
    animation: fadeIn 0.3s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Product Grid - Mobile: Single Column Stack */
  .featured-collections__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: 40px;
  }

  .featured-collections__product-card {
    position: relative;
    overflow: hidden;
    display: flex;
    height: 460px;
  }

  .featured-collections__product-link {
    display: flex;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .featured-collections__product-image {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: flex;
    border-radius: 40px;
  }

  .featured-collections__product-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;

    transition: transform 0.3s ease;
  }

  .featured-collections__product-card:hover .featured-collections__product-image img {
    transform: scale(1.05);
  }

  /* Button */
  .featured-collections__button-wrapper {
    display: none;
  }

  .featured-collections__button {
    display: inline-block;
    padding: 16px 32px;
    background-color: #c19687;
    border-radius: 1000px;
    color: #ffffff;
    font-size: 18px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .featured-collections__button:hover {
    background-color: #c89981;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(212, 169, 145, 0.3);
  }

  @media (min-width: 640px) {
    .featured-collections__wrapper {
      justify-content: center;
    }
  }

  /* ========================================
     TABLET STYLES (min-width: 768px)
     ======================================== */

  @media (min-width: 768px) {
    .featured-collections {
      padding: 80px 0 100px;
    }

    .featured-collections__container {
      padding: 0 32px;
    }

    .featured-collections__richtext {
      margin-bottom: 40px;
    }

    .featured-collections__heading {
      font-size: 48px;
      margin: 0 0 16px 0;
    }

    .featured-collections__subheading {
      font-size: 16px;
    }

    .featured-collections__tabs {
      margin-bottom: 40px;
      justify-content: center;
    }

    .featured-collections__tab {
      padding: 14px 32px;
      font-size: 16px;
    }

    /* Tablet Grid Layout:
       - Product 1: Left column (small)
       - Product 2: Right column spanning 2 rows (tall)
       - Products 3, 4, 5: Bottom row
    */
    .featured-collections__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      height: 375px;
    }

    .featured-collections__button-wrapper {
      display: flex;
      justify-content: center;
      margin-top: 24px;
    }

    .featured-collections__product-card {
      height: auto;
    }
  }

  @media (min-width: 1024px) {
    .featured-collections {
      padding: 100px 0 120px;
    }

    .featured-collections__container {
      padding: 0 40px;
    }

    .featured-collections__richtext {
      margin-bottom: 48px;
    }

    .featured-collections__heading {
      font-size: 52px;
      margin: 0 0 16px 0;
    }

    .featured-collections__subheading {
      font-size: 18px;
    }

    .featured-collections__tabs {
      margin-bottom: 48px;
    }

    .featured-collections__tab {
      padding: 16px 40px;
      font-size: 16px;
    }

    .featured-collections__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      height: 540px;
    }
  }
</style>

<script>
  (function () {
    // Tab switching functionality
    const tabs = document.querySelectorAll('.featured-collections__tab');
    const panels = document.querySelectorAll('.featured-collections__panel');

    tabs.forEach((tab) => {
      tab.addEventListener('click', function (e) {
        const tabIndex = this.getAttribute('data-tab-index');

        // Remove active class from all tabs and panels
        tabs.forEach((t) => t.classList.remove('active'));
        panels.forEach((p) => p.classList.remove('active'));

        // Add active class to clicked tab and corresponding panel
        this.classList.add('active');
        const activePanel = document.querySelector(`.featured-collections__panel[data-panel-index="${tabIndex}"]`);
        if (activePanel) {
          activePanel.classList.add('active');
        }
      });
    });

    // Drag to scroll functionality for the wrapper (mobile)
    document.querySelectorAll('.featured-collections__wrapper').forEach((wrapper) => {
      let isDown = false;
      let startX;
      let scrollLeft;
      let hasMoved = false;

      wrapper.addEventListener('mousedown', (e) => {
        isDown = true;
        hasMoved = false;

        startX = e.pageX - wrapper.offsetLeft;
        scrollLeft = wrapper.scrollLeft;
      });

      wrapper.addEventListener('mouseleave', () => {
        isDown = false;
      });

      wrapper.addEventListener('mouseup', () => {
        isDown = false;
      });

      wrapper.addEventListener('mousemove', (e) => {
        if (!isDown) return;
        e.preventDefault();
        hasMoved = true;
        const x = e.pageX - wrapper.offsetLeft;
        const walk = (x - startX) * 2; // scroll speed
        wrapper.scrollLeft = scrollLeft - walk;
      });

      // Touch events for mobile devices
      let touchStartX = 0;
      let touchScrollLeft = 0;

      wrapper.addEventListener('touchstart', (e) => {
        touchStartX = e.touches[0].pageX - wrapper.offsetLeft;
        touchScrollLeft = wrapper.scrollLeft;
        hasMoved = false;
      });

      wrapper.addEventListener('touchmove', (e) => {
        hasMoved = true;
        const x = e.touches[0].pageX - wrapper.offsetLeft;
        const walk = (x - touchStartX) * 2;
        wrapper.scrollLeft = touchScrollLeft - walk;
      });

      // Prevent click event if user was dragging
      wrapper.addEventListener(
        'click',
        (e) => {
          if (hasMoved) {
            e.preventDefault();
            e.stopPropagation();
          }
        },
        true
      );
    });
  })();
</script>

