<section class="craftsmanship-section" data-section-id="{{ section.id }}">
  <div class="craftsmanship-section__container">
    <div class="craftsmanship-section__richtext">
      {%- if section.settings.heading != blank -%}
        <h2 class="craftsmanship-section__heading poppins-bold">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <h4 class="craftsmanship-section__subheading">{{ section.settings.subheading }}</h4>
      {%- endif -%}
    </div>
    <div class="craftsmanship-section__image">
      {% if section.settings.section_image != blank %}
        <img
          src="{{ section.settings.section_image | image_url }}"
          alt="{{ section.settings.section_image | default: 'Craftsmanship section image' }}"
          width="{{ section.settings.section_image.width }}"
          height="{{ section.settings.section_image.height }}"
          loading="lazy"
        >
      {% else %}
        <img
          src="{{ 'craftsmanship-img.png' | asset_url }}"
          alt="Image of a featured product"
          width="1119"
          height="709"
          loading="lazy"
        >
      {% endif %}
    </div>
  </div>
</section>

<style>
  .craftsmanship-section {
    padding: 60px 0 80px;
    display: none;
  }

  .craftsmanship-section__container {
    max-width: 1376px;
    margin: 0 auto;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
  }

  .craftsmanship-section__richtext {
    margin-bottom: 32px;
  }

  .craftsmanship-section__heading {
    font-size: 32px;
    color: #343434;
    text-align: center;
    margin: 0 0 16px 0;
  }

  .craftsmanship-section__subheading {
    font-size: 1rem;
    color: #000;
    text-align: center;
    margin: 0;
    font-weight: 400;
    line-height: 150%;
  }

  .craftsmanship-section__image {
    display: flex;
    justify-content: center;
    margin-top: 42px;
  }

  @media (min-width: 768px) {
    .craftsmanship-section {
      padding: 80px 0 100px;
      display: block;
    }

    .craftsmanship-section__container {
      padding: 0 32px;
    }

    .craftsmanship-section__richtext {
      margin-bottom: 40px;
    }

    .craftsmanship-section__heading {
      font-size: 48px;
      margin: 0 0 16px 0;
    }

    .craftsmanship-section__subheading {
      font-size: 16px;
    }
  }

  @media (min-width: 1024px) {
    .craftsmanship-section {
      padding: 100px 0 120px;
    }

    .craftsmanship-section__container {
      padding: 0 40px;
    }

    .craftsmanship-section__richtext {
      margin-bottom: 48px;
    }

    .craftsmanship-section__heading {
      font-size: 52px;
      margin: 0 0 16px 0;
    }

    .craftsmanship-section__subheading {
      font-size: 18px;
    }
  }
</style>

{% schema %}
{
  "name": "Craftsmanship & Details",
  "settings": [
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Craftsmanship & Details"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our products are made with high-quality materials and careful attention to detail to ensure comfort, durability, and long-lasting performance. We use soft, safe, and reliable fabrics combined with strong stitching and premium finishing to deliver the best possible experience."
    },
    {
      "type": "image_picker",
      "id": "section_image",
      "label": "Section image"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "Craftsmanship & Details",
      "category": "Little BoLiving"
    }
  ]
}
{% endschema %}
