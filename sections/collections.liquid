{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<div class="page-width">
  <h1>{{ 'collections.title' | t }}</h1>

  <div
    class="collections {{ section.settings.grid_item_width }}"
    style="--grid-gap: {{ section.settings.grid_gap }}px"
  >
    {% for collection in collections %}
      <a class="collection-card" href="{{ collection.url }}">
        <div class="collection-card__image-wrapper">
          {% if collection.featured_image %}
            {% render 'image',
              class: 'collection-card__image',
              image: collection.featured_image,
              width: 600,
              height: 600,
              crop: 'center'
            %}
          {% endif %}
        </div>

        <div class="collection-card__content">
          <p class="collection-card__title">
            {{ collection.title }}
            <svg
              viewBox="0 0 14 10"
              fill="none"
              aria-hidden="true"
              focusable="false"
              class="icon icon-arrow"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path fill-rule="evenodd" clip-rule="evenodd" d="M8.537.808a.5.5 0 01.817-.162l4 4a.5.5 0 010 .708l-4 4a.5.5 0 11-.708-.708L11.793 5.5H1a.5.5 0 010-1h10.793L8.646 1.354a.5.5 0 01-.109-.546z" fill="currentColor"></path>
            </svg>
          </p>
        </div>
      </a>
    {% endfor %}
  </div>
</div>
<div class="contact-newsletter">
  <div class="page-width">
    <div class="contact-newsletter__content">
      <h2 class="contact-newsletter__title">Subscribe to our emails</h2>

      {%- form 'contact' -%}
        {% if form.posted_successfully? %}
          <div class="form-success">Thanks for contacting us. We'll get back to you as soon as possible.</div>
        {% endif %}

        <div class="contact-newsletter__input-wrapper">
          <input
            type="email"
            name="contact[email]"
            id="NewsletterEmail"
            placeholder="Email"
            class="contact-newsletter__input"
            aria-label="Email address"
            required
          >
          <button type="submit" class="contact-newsletter__submit" aria-label="Subscribe">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .page-width {
    max-width: 1244px;
    margin: 0 auto;
    padding: 0 16px;
    margin-top: 1rem;
  }

  @media screen and (min-width: 750px) {
    .page-width {
      padding: 0 5rem;
    }
  }

  h1 {
    font-size: 30px;
    font-weight: 400;
    line-height: 1;
    padding-block: 40px;
    letter-spacing: normal;
    color: #121212 !important;
  }

  @media screen and (min-width: 750px) {
    h1 {
      font-size: 40px;
      margin-block: 2rem !important;
    }
  }

  .collections {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 989px) {
    .collections {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .collections--compact {
    --collection-card-size: 160px;
  }

  .collections--full {
    --collection-card-size: 280px;
  }

  .collection-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
    color: rgb(18, 18, 18);
  }

  .collection-card:nth-of-type(4) {
    justify-content: center;
    background-color: hsl(0, 0%, 95%);
  }

  .collection-card:nth-of-type(4) > .collection-card__content {
    padding: 1rem;
  }

  .collection-card__image-wrapper {
    position: relative;
    width: 100%;
    background-color: rgba(18, 18, 18, 0.04);
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .collection-card__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .collection-card:hover .collection-card__image {
    transform: scale(1.03);
  }

  .collection-card__content {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .collection-card__title {
    font-size: 1rem;
    font-weight: 400;
    line-height: 1.3;
    color: #121212;
    letter-spacing: 1;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .icon-arrow {
    height: 1rem;
    width: auto !important;
    transition: transform 0.2s ease;
  }

  .collection-card:hover .icon-arrow {
    transform: translateX(0.3rem);
  }

  /* Newsletter Section */
  .contact-newsletter {
    padding: 60px 0;
    margin-top: 32px;
    border-top: 1px solid #e5e5e5;
  }

  .contact-newsletter__content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-newsletter__title {
    font-size: 24px;
    font-weight: 400;
    margin: 0 0 30px 0;
  }

  .contact-newsletter__input-wrapper {
    position: relative;
    max-width: 400px;
    margin: 0 auto;
  }

  .contact-newsletter__input {
    width: 100%;
    padding: 15px 60px 15px 20px;
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 16px;
    background-color: #fff;
  }

  .contact-newsletter__input:focus {
    outline: none;
    border-color: #000;
  }

  .contact-newsletter__submit {
    position: absolute;
    right: 5px;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    padding: 10px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .contact-newsletter__submit:hover {
    opacity: 0.7;
  }

  .contact-newsletter__success {
    background-color: #4caf50;
    color: white;
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 15px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "select",
      "id": "grid_item_width",
      "label": "t:labels.grid_item_width",
      "options": [
        { "value": "collections--compact", "label": "t:options.size.small" },
        { "value": "collections--full", "label": "t:options.size.large" }
      ],
      "default": "collections--full"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 30
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
