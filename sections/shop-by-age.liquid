{% comment %}
  Custom Shop by Age Section for Little BoLiving
  Responsive design with mobile-first approach
{% endcomment %}

<section class="shop-by-age" data-section-id="{{ section.id }}">
  <div class="shop-by-age__container">
    <div class="shop-by-age__richtext">
      {%- if section.settings.heading != blank -%}
        <h2 class="shop-by-age__heading poppins-bold">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <h4 class="shop-by-age__subheading">{{ section.settings.subheading }}</h4>
      {%- endif -%}
    </div>

    <div class="shop-by-age__grid">
      {%- for block in section.blocks -%}
        <div
          class="shop-by-age__card"
          style="background-color: {{ block.settings.card_bg_color }};"
          {{ block.shopify_attributes }}
        >
          <div class="shop-by-age__card-content">
            <h3 class="shop-by-age__card-title poppins-bold">{{ block.settings.age_range }}</h3>
            <p class="shop-by-age__card-subtitle poppins-bold">{{ block.settings.subtitle }}</p>
            <p class="shop-by-age__card-description">{{ block.settings.description }}</p>

            {%- if block.settings.button_url != blank -%}
              <a href="{{ block.settings.button_url }}" class="shop-by-age__button inter-bold" role="button">
                {{ block.settings.button_text }}
                <svg
                  class="shop-by-age__button-icon"
                  width="24"
                  height="24"
                  viewBox="0 0 20 20"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M7.5 15l5-5-5-5"/>
                </svg>
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  /* ========================================
     BASE STYLES (Mobile First)
     ======================================== */

  .shop-by-age {
    max-width: 1376px;
    margin: 0 auto;
  }

  .shop-by-age__container {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-inline: 16px;
    margin-top: 51px;
  }

  /* Heading */
  .shop-by-age__richtext {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .shop-by-age__heading {
    font-size: 32px;
    color: #343434;
  }

  .shop-by-age__subheading {
    font-size: 1rem;
    text-align: center;
  }

  /* Grid Layout */
  .shop-by-age__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* Card Styles */
  .shop-by-age__card {
    border-radius: 32px;
    padding: 24px 20px;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .shop-by-age__card-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    height: 100%;
  }

  /* Card Title (Age Range) */
  .shop-by-age__card-title {
    font-size: 42px;
    color: #343434;
  }

  /* Card Subtitle (Years) */
  .shop-by-age__card-subtitle {
    font-size: 20px;
    color: #343434;
  }

  /* Card Description */
  .shop-by-age__card-description {
    font-size: 14px;
    color: #343434;
    margin-top: 12px;
    text-align: center;
  }

  /* Button */
  .shop-by-age__button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 16px 24px 16px 32px;
    background-color: transparent;
    border: 1px solid #343434;
    border-radius: 1000px;
    color: #343434;
    font-size: 16px;
    transition: all 0.2s ease;
    margin-top: 32px;
  }

  .shop-by-age__button-icon {
    width: 24px;
    height: 24px;
    transition: transform 0.2s ease;
  }

  .shop-by-age__button:hover .shop-by-age__button-icon {
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .shop-by-age__container {
      margin-inline: 32px;
      margin-top: 42px;
    }

    .shop-by-age__heading {
      font-size: 48px;
    }

    .shop-by-age__subheading {
      font-size: 18px;
    }

    .shop-by-age__grid {
      gap: 20px;
      padding-top: 24px;
    }

    .shop-by-age__card {
      padding: 40px 42px;
    }

    .shop-by-age__card-title {
      font-size: 48px;
    }

    .shop-by-age__card-subtitle {
      font-size: 20px;
    }

    .shop-by-age__card-description {
      font-size: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .shop-by-age__container {
      margin-top: 50px;
    }

    .shop-by-age__heading {
      font-size: 52px;
    }

    .shop-by-age__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .shop-by-age__card {
      padding: 48px 28px;
    }

    .shop-by-age__card-title {
      font-size: 56px;
    }

    .shop-by-age__card-description {
      font-size: 16px;
    }
  }

  @media (min-width: 1280px) {
    .shop-by-age__container {
      margin-top: 100px;
    }
  }

  @media (min-width: 1280px) {
    .shop-by-age__container {
      margin-top: 120px;
    }
  }
</style>

{% schema %}
